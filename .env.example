NEXT_PUBLIC_INSTANT_APP_ID=

# Spotify — required for resolving Spotify links (Client Credentials flow)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube — optional; single-video links work without it (oEmbed).
# Required for resolving YouTube playlists.
YOUTUBE_API_KEY=

# App URL used for deep links / share targets
NEXT_PUBLIC_APP_URL=
